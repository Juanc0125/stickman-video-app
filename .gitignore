node_modules/
.next/
out/
dist/
build/
coverage/
apps/render-worker/renders/
# Voice model downloaded at runtime (~78MB) - never belongs in the repo.
apps/render-worker/.voice-cache/

# Graphify output. The graph is versioned on purpose: it is read far more often than it is
# rebuilt, and regenerating it costs a full extraction run. Only the rebuild
# cache and the interpreter paths, which are per-machine, stay out.
graphify-out/cache/
# Dated snapshots the rebuild takes of the previous graph: a copy of something
# already in git history, and one more folder per day.
graphify-out/20*/
graphify-out/.graphify_*

.env
.env.*
!.env.example
!.env.local.example

*.log
.DS_Store
Thumbs.db
.vercel
.supabase/
supabase/.temp/

# Per-machine Claude Code settings: the graphify hook points at an absolute
# path that only exists on this computer.
.claude/settings.local.json
