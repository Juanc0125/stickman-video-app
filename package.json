{
  "name": "stickman-video-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/render-worker"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace web",
    "dev:worker": "npm run dev --workspace @stickman-video-app/render-worker",
    "build": "npm run build --workspace web && npm run build --workspace @stickman-video-app/render-worker",
    "build:web": "npm run build --workspace web",
    "build:worker": "npm run build --workspace @stickman-video-app/render-worker",
    "start:web": "npm run start --workspace web",
    "start:worker": "npm run start --workspace @stickman-video-app/render-worker",
    "lint": "npm run lint --workspace web",
    "check:types": "npm run check:types --workspace @stickman-video-app/render-worker",
    "verify": "npm run lint && npm run check:types && npm run build",
    "e2e": "node scripts/e2e.mjs",
    "check:ai": "node scripts/check-ai.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}